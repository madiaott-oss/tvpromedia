                          if (targetCh) {
                            const k = targetCh.rtmpKey || ('live_' + (targetCh.nom.toLowerCase().replace(/[^a-z0-9]/g, '_') || 'ch') + '_' + Math.random().toString(36).substring(2, 6));
                            setGenStreamKey(k);
                            setGenRtmpServer(targetCh.rtmpUrl || `rtmp://191.215.38.95:1935/live`);
                            setGenM3u8Url(targetCh.lien || `https://www.tvpromedia.com/live/${k}.m3u8`);
                          }
                        }
