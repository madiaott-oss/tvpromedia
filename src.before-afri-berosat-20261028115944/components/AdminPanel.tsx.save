                      className="bg-[#121829] hover:bg-[#1a233b] active:scale-95 border border-white/5 hover:border-red-500/40 rounded-xl p-2.5 text-left transition-all group flex flex-col justify-between gap-1 shadow-sm disabled:opacity-50"
